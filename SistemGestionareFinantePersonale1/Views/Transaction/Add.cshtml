<h2>Add Transaction</h2>

<form asp-action="Add" method="post">

    <div>
        <label>Type</label>
        <select name="type">
            <option value="Income">Income</option>
            <option value="Expense">Expense</option>
        </select>
    </div>

    <div>
        <label>Amount</label>
        <input type="number" name="amount" />
    </div>

    <button type="submit">Add</button>

</form>