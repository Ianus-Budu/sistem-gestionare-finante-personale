@model IEnumerable<SistemGestionareFinantePersonale1.Models.Transaction>

@{
    ViewData["Title"] = "Tranzacții";
    var currency = ApplicationSettings.Instance.Currency;
    var income = Model.Where(t => t.Type == "Income").Sum(t => t.Amount);
    var expense = Model.Where(t => t.Type == "Expense").Sum(t => t.Amount);
    var total = income - expense;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tranzacții</h1>
        <p class="text-muted mb-0">Vezi rapid veniturile, cheltuielile și totalul curent.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Add" asp-route-type="Expense">+ Cheltuială</a>
        <a class="btn btn-outline-secondary" asp-action="Add" asp-route-type="Income">+ Venit</a>
        <a class="btn btn-outline-light" style="border-color: rgba(255,255,255,.35)" asp-action="UploadReceipt">Bon fiscal (QR)</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card p-3">
            <div class="stat-label">Venituri</div>
            <div class="stat-value text-success">@income @currency</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card p-3">
            <div class="stat-label">Cheltuieli</div>
            <div class="stat-value text-danger">@expense @currency</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card p-3">
            <div class="stat-label">Total</div>
            <div class="stat-value">@total @currency</div>
        </div>
    </div>
</div>

<div class="card card-soft">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tip</th>
                        <th>Descriere</th>
                        <th class="text-end">Sumă</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Date.ToShortDateString()</td>
                            <td>
                                @if (t.Type == "Income")
                                {
                                    <span class="badge text-bg-success">Venit</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Cheltuială</span>
                                }
                            </td>
                            <td>@t.Description</td>
                            <td class="text-end fw-semibold">@t.Amount @currency</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
